{
  "schemaVersion": 1,
  "id": "skystudio",
  "version": "${version}",
  "name": "Sky Studio",
  "description": "Client-side sky control: time of day, sun/sky colours, stars, galaxies, shooting stars, clouds and a solar system.",
  "environment": "client",
  "entrypoints": { "client": ["com.example.skystudio.SkyStudioClient"] },
  "mixins": ["skystudio.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3 <27",
    "java": ">=25",
    "fabric-api": "*"
  }
}
